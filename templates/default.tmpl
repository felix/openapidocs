{{if .Standalone}}
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">
		<title>{{.Title}} — API reference</title>
		{{.StyleContent}}
	</head>
	<body>
		{{end}}
		<div class="layout">
			<header>
				<strong>{{.Title}}</strong>
				<span> API reference · {{.Version}}</span>
			</header>

			{{$tags := .Tags}}

			{{template "sidebar" .}}

			<main>
				<section id="overview">
					<h1>{{.Title}}</h1>
					<p>Version {{.Version}}</p>
					<p>{{.Description}}</p>
					{{$prefix := "/"}}
					{{if .Servers}}
					{{$prefix = (index .Servers 0).URL}}
					<h2>Servers</h2>
					<ul>
						{{ range $server := .Servers }}
						<li>
							<code>{{$server.URL}}</code>
							{{ if $server.Description }} — {{$server.DescriptionHTML}}{{end}}
						</li>
						{{end}}
					</ul>
					{{end}}
				</section>

				<section id="endpoints">
					{{range .Endpoints}}
					<article id="{{.Slug}}">
						<div class="operation-detail">
							<h3>
								<span class="tag method {{.Method}}">{{.Method}}</span>
								<code>{{.Path}}</code>
							</h3>

							{{with .Summary}}<p><strong>{{.}}</strong></p>{{end}}

							<!--
							<div class="tags">
							Tags: {{range .Tags}}<span class="tag">{{.}}</span>{{end}}
							</div>
							-->

							{{with .Description}}<p>{{.}}</p>{{end}}

							{{template "parameters" .Parameters}}

							{{with .RequestBody}}{{template "requestBody" .}}{{end}}

							{{if .Responses}}
							<h4>Responses</h4>
							{{range $status, $response := .Responses }}
							<details class="{{if not $response.Content}}no-content{{end}}">
								<summary class="status-{{$status}}">
									{{template "statusCode" $status}}
									{{$response.Description}}
								</summary>
								{{if $response.Content}}
								{{template "responseBody" $response}}
								{{else}}
								<p class="response">
								<span class="status-{{$status}}">
									{{template "statusCode" $status}}
									<span class="description">{{$response.Description}}</span>
								</span>
								</p>
								{{end}}
							</details>
							{{end}}
							{{end}}
						</div>

						{{template "sampleAside" .}}

					</article>
					{{end}}
				</section>

			</main>
		</div>
		{{if not .Standalone}}
	</body>
</html>
{{end}}

{{define "sidebar"}}
{{$tags := .Tags}}
<nav class="sidebar">
	<strong>Contents</strong>
	<ul>
		<li><a href="#overview">Overview</a></li>
		{{range $tagName, $endpoints := .TagGroups}}
		{{$tag := index $tags $tagName}}
		<li>
			<details>
				<summary title="{{$tag.Description}}">{{$tagName}}</summary>
				{{if $tag.Description}}
				<p class="description">{{$tag.DescriptionHTML}}</p>
				{{end}}
				<ul>
					{{range $endpoint := $endpoints}}
					<li class="endpoint">
						<a href="#{{$endpoint.Slug}}">
							<span class="tag method {{$endpoint.Method}}">{{$endpoint.Method}}</span>
							{{$endpoint.Summary}}
						</a>
					</li>
					{{end}}
				</ul>
			</details>
		</li>
		{{end}}
	</ul>
</nav>
{{end}}

{{define "statusCode"}}
<span class="tag status" title="HTTP status {{.}}">{{.}}</span>
{{end}}

{{define "requestBody"}}
<div class="request-body">
	<h4>Request body {{if .Required}}<span class="tag required">Required</span>{{end}}</h4>
	{{.DescriptionHTML}}
	{{range $type, $content := .Content}}
	<p class="media-type">{{$type}}</p>
	{{if $content.Schema}}
	{{template "schema" $content.Schema}}
	{{end}}
	{{end}}
</div>
{{end}}

{{define "responseBody"}}
<div class="response-body">
	<h4>Response body</h4>
	{{range $type, $content := .Content}}
	<p class="media-type">{{$type}}</p>
	{{if $content.Schema}}
	{{template "schema" $content.Schema}}
	{{end}}
	{{end}}
</div>
{{end}}

{{define "parameters"}}
{{range $in, $params := .}}
{{if $params}}
<h4>
	{{$in}} parameters
	{{if eq $in "path"}}<span class="tag required">required</span>{{end}}
</h4>
<div class="schema">
	<dl class="parameters">
		{{range $params}}
		<dt class="parameter">
			<span class="name">{{.Name}}</span>
			{{if ne .In "path"}}
			{{if .Required }}<span class="tag required">required</span>{{end}}
			{{end}}
		</dt>
		<dd>
			{{with .Schema}}
			{{if ne .Type "array"}}<span class="schema-type">{{.Type}}</span>{{end}}
			{{with .Format}}<span class="schema-format">&lt;{{.}}&gt;</span>{{end}}
			{{template "schema" .}}
			{{end}}
			{{if .Description}}<span class="description">{{.DescriptionHTML}}</span>{{end}}
		</dd>
		{{end}}
	</dl>
</div>
{{end}}
{{end}}
{{end}}

{{define "properties"}}
<dl class="properties">
	{{range $name, $schema := .}}
	<dt class="property">
		<span class="name">{{$name}}</span>
		{{if .Required }}<span class="tag required">{{.Required}}</span>{{end}}
	</dt>
	<dd>
		{{with $schema}}
		{{if ne .Type "array"}}<span class="schema-type">{{.Type}}</span>{{end}}
		{{with .Format}}<span class="schema-format">&lt;{{.}}&gt;</span>{{end}}
		{{template "schema" .}}
		{{end}}
	</dd>
	{{end}}
</dl>
{{end}}

{{define "schema"}}
<div class="schema">
	{{if eq .Type "array"}}
	<span class="schema-type">array of {{.Items.Type}}</span>
	{{if eq .Items.Type "object"}}
	{{if .Items.Properties}}
	<br>Array [<br>{{template "schema" .Items}}]
	{{end}}
	{{end}}
	{{end}}
	{{if .Description}}<span class="description">{{.DescriptionHTML}}</span>{{end}}
	{{if .Enum}}<span class="enums">Enum:
		{{range $i, $value := .Enum}}<span class="enum">{{printf "%v" $value}}</span>{{end}}
	</span>
	{{end}}
	{{if .Example}}<span class="example">Example: <pre>{{printf "%s" .Example}}</pre></span>{{end}}
		{{if .Properties}}
		{{template "properties" .Properties}}
		{{end}}
</div>
{{end}}

{{define "sampleAside"}}
{{$endpoint := .}}
<aside class="samples">
	<h4>Request</h4>
	{{if gt (len .Prefixes) 1}}
	<select>
	{{range .Prefixes}}
	<option>
	<code class="path">{{$endpoint.Method}} {{.}}{{$endpoint.Path}}</code>
	</option>
	{{end}}
	</select>
	{{else}}
	<code class="path">{{$endpoint.Method}} {{index .Prefixes 0}}{{$endpoint.Path}}</code>
	{{end}}

	{{if .RequestBody}}
	{{range $mediaType, $content := .RequestBody.Content}}
	<details class="sample">
		<summary>{{$mediaType}}</summary>
		{{template "sample" $content}}
	</details>
	{{end}}
	{{end}}

	{{if .Responses}}
	<h4>Response</h4>
	{{range $status, $response := .Responses -}}
	<details class="{{if not $response.Content}}no-content{{end}}">
		<summary>
			{{template "statusCode" $status}}
			{{$response.Description}}
		</summary>
		{{if $response.Content}}
		{{range $mediaType, $content := $response.Content}}
		<span class="media-type">{{$mediaType}}</span>
		{{template "sample" $content}}
		{{end}}
		{{else}}
		<p>No content</p>
		{{end}}
	</details>
	{{end}}
	{{end}}
</aside>
{{end}}

{{define "sample"}}
{{if .Example }}
<div class="example">
	<pre><code>{{printf "%v" .Example}}</code></pre>
</div>
{{end}}

{{range $name, $example := .Examples}}
<div class="example">
	<p class="label">
	{{if $example.Summary}}{{$example.Summary}}{{else}}{{$name}}{{end}}
	</p>
	{{if $example.Description}}
	<p>{{$example.DescriptionHTML}}</p>
	{{end}}
	{{if $example.Rendered}}
	<pre><code class="rendered">{{$example.Rendered}}</code></pre>
	{{else}}
	<pre><code class="value">{{printf "%v" $example.Value}}</code></pre>
	{{end}}
</div>
{{end}}
{{end}}
