{{if .Standalone}}
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">
		<title>{{.Title}} — API reference</title>
		{{.StyleContent}}
	</head>
	<body>
		{{end}}
		<div class="layout">
			<header>
				<strong>{{.Title}}</strong>
				<span> API reference · {{.Version}}</span>
			</header>
			<aside class="sidebar">
				{{$tags := .Tags}}
				<nav>
					<strong>Contents</strong>
					<ul>
						<li><a href="#overview">Overview</a></li>
						{{range $tag, $endpoints := .TagGroups}}
						<li>
							<details>
								<summary>{{$tag}}</summary>
								<ul>
									{{range $endpoint := $endpoints}}
									<li>
										<a href="#{{$endpoint.Slug}}">
											<span class="method {{$endpoint.Method}}">{{$endpoint.Method}}</span>
											{{$endpoint.Summary}}
										</a>
									</li>
									{{end}}
								</ul>
							</details>
						</li>
						{{end}}
					</ul>
				</nav>
			</aside>
			<main>
				<section id="overview">
					<h1>{{.Title}}</h1>
					<p>Version {{.Version}}</p>
					<p>{{.Description}}</p>
					{{$prefix := "/"}}
					{{if .Servers }}
					{{$prefix = (index .Servers 0).URL}}
					<h2>Servers</h2>
					<ul>
						{{ range $server := .Servers }}
						<li>
							<code>{{$server.URL}}</code>
							{{ if $server.Description }} — {{$server.DescriptionHTML}}{{end}}
						</li>
						{{end}}
					</ul>
					{{end}}
				</section>
				{{ range $tag, $endpoints := .TagGroups }}
				<section id="tag-{{$tag}}">
					<h2>{{(index $tags $tag).Description}}</h2>
					{{ range $endpoint := $endpoints }}
					<article id="{{$endpoint.Slug}}">
						<div class="operation-detail">
							<h3>
								<span class="method {{$endpoint.Method}}">{{$endpoint.Method}}</span>
								<code>{{$endpoint.Path}}</code>
							</h3>

							{{ if $endpoint.Summary }}
							<p><strong>{{$endpoint.Summary}}</strong></p>
							{{end}}

							{{ if $endpoint.Description }}
							<p>{{$endpoint.Description}}</p>
							{{end}}

							{{range $in, $params := $endpoint.Parameters}}
							{{if gt (len $params) 0 }}
							<h4>{{$in}} parameters</h4>
							<div class="schema">
								{{template "parameters" $params}}
							</div>
							{{end}}
							{{end}}

							{{if $endpoint.RequestBody}}
							{{template "requestBody" $endpoint.RequestBody}}
							{{end}}

							{{if $endpoint.Responses}}
							<h4>Responses</h4>
							{{range $code, $response := $endpoint.Responses }}
							{{if $response.Content}}
							<details class="response">
								<summary class="code-{{$code}}">
									<span class="code">{{$code}}</span>
									{{$response.Description}}
								</summary>
								{{template "responseBody" $response}}
							</details>
							{{else}}
							<p class="response">
							<span class="code-{{$code}}">
								<span class="code">{{$code}}</span>
								<span class="description">{{$response.Description}}</span>
							</span>
							</p>
							{{end}}
							{{end}}
							{{end}}
						</div>

						<aside class="operation-samples">
							<h4>Request</h4>
							<pre><code>{{$endpoint.Method}} {{$prefix}}{{$endpoint.Path}}</code></pre>
							{{if $endpoint.RequestBody}}
							{{range $mediaType, $content := $endpoint.RequestBody.Content}}
							<details class="sample">
								<summary>{{$mediaType}}</summary>
								{{template "sample" $content}}
							</details>
							{{end}}
							{{end}}

							<h4>Response</h4>
							{{range $status, $response := $endpoint.Responses -}}
							{{if $response.Content}}
							<details>
								<summary> {{$status}} {{$response.Description}} </summary>
								{{range $mediaType, $content := $response.Content}}
								<span class="media-type">{{$mediaType}}</span>
								{{template "sample" $content}}
								{{end}}
							</details>
							{{end}}
							{{end}}
						</aside>
					</article>
					{{end}}
				</section>
				{{end}}
			</main>
		</div>
		{{if not .Standalone}}
	</body>
</html>
{{end}}

{{define "requestBody"}}
<div class="request-body">
	<h4>Request body {{if .Required}}<span class="required">Required</span>{{end}}</h4>
	{{.DescriptionHTML}}
	{{range $type, $content := .Content}}
	<p class="media-type">{{$type}}</p>
	{{if $content.Schema}}
	{{template "schema" $content.Schema}}
	{{end}}
	{{end}}
</div>
{{end}}

{{define "responseBody"}}
<div class="response-body">
	<h4>Response body</h4>
	{{range $type, $content := .Content}}
	<p class="media-type">{{$type}}</p>
	{{if $content.Schema}}
	{{template "schema" $content.Schema}}
	{{end}}
	{{end}}
</div>
{{end}}

{{define "parameters"}}
<dl class="parameters">
	{{range .}}
	<dt class="parameter">
		<span class="name">{{.Name}}</span>
		{{if .Required }}<span class="required">required</span>{{end}}
	</dt>
	<dd>
		{{with .Schema}}
		{{if ne .Type "array"}}<span class="type">{{.Type}}</span>{{end}}
		{{with .Format}}<span class="format">&lt;{{.}}&gt;</span>{{end}}
		{{template "schema" .}}
		{{end}}
		{{if .Description}}<span class="description">{{.DescriptionHTML}}</span>{{end}}
	</dd>
	{{end}}
</dl>
{{end}}

{{define "properties"}}
<dl class="properties">
	{{range $name, $schema := .}}
	<dt class="property">
		<span class="name">{{$name}}</span>
		{{if .Required }}<span class="required">{{.Required}}</span>{{end}}
	</dt>
	<dd>
		{{with $schema}}
		{{if ne .Type "array"}}<span class="type">{{.Type}}</span>{{end}}
		{{with .Format}}<span class="format">&lt;{{.}}&gt;</span>{{end}}
		{{template "schema" .}}
		{{end}}
	</dd>
	{{end}}
</dl>
{{end}}

{{define "schema"}}
<div class="schema">
	{{if eq .Type "array"}}
	<span class="type">array of {{.Items.Type}}</span>
	{{if eq .Items.Type "object"}}
	{{if .Items}}<br>Array [<br>{{template "schema" .Items}}<br>]{{end}}
	{{end}}
	{{end}}
	{{if .Description}}<span class="description">{{.DescriptionHTML}}</span>{{end}}
	{{if .Enum}}<span class="enums">Enum:
		{{range $i, $value := .Enum}}<span class="enum">{{printf "%v" $value}}</span>{{end}}
	</span>
	{{end}}
	{{if .Example}}<span class="example">Example: <pre>{{printf "%s" .Example}}</pre></span>{{end}}
		{{if .Properties}}
		{{template "properties" .Properties}}
		{{end}}
</div>
{{end}}

{{define "sample"}}
	{{if .Example }}
	<div class="example">
		<p class="sample-label">Example</p>
		<pre><code>{{printf "%v" .Example}}</code></pre>
	</div>
	{{end}}

	{{range $name, $example := .Examples}}
	<div class="example">
		<p class="sample-label">
		{{if $example.Summary}}{{$example.Summary}}{{else}}{{$name}}{{end}}
		</p>
		{{if $example.Description}}
		<p>{{$example.DescriptionHTML}}</p>
		{{end}}
		{{if $example.Rendered}}
		<pre><code class="rendered">{{$example.Rendered}}</code></pre>
		{{else}}
		<pre><code class="value">{{printf "%v" $example.Value}}</code></pre>
		{{end}}
	</div>
	{{end}}
{{end}}
